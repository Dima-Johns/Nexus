# Nusxa oling: .env  (haqiqiy .env GitHub'ga yuklanmaydi)

# Lokal PostgreSQL. Railway'da: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql+psycopg://nexus:PAROL@127.0.0.1:5432/logistika

# Bo‘sh bazada birinchi marta yaratiladigan login parollari (admin / dispatcher)
ADMIN_PASSWORD=
DISPATCHER_PASSWORD=

# Yetkazib berish rasmlari papkasi. Railway'da Volume ulab: UPLOAD_DIR=/data/uploads
# UPLOAD_DIR=uploads

# GPS'siz haydovchilarni xaritada sun'iy yurgizish (faqat demo uchun)
# SIMULATE_GPS=0
